{
  "version": 2,
  "buildCommand": "cd backend && npm run vercel-build",
  "installCommand": "cd backend && npm install",
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "backend/api/index.ts": {
      "maxDuration": 30,
      "memory": 512,
      "includeFiles": "backend/src/**"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/backend/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/backend/api/index"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization,x-request-id" }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
