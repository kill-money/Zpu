# ============================================
# Vercel Production Environment Variables
# ============================================
# Copy these to Vercel Dashboard > Settings > Environment Variables
# DO NOT commit real secrets to git!
# ============================================

# ---- Database ----
# MongoDB Atlas connection string (replace with your Atlas URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/zpu-loan?retryWrites=true&w=majority

# Redis Cloud (already configured)
REDIS_URL=redis://default:<password>@redis-15484.c239.us-east-1-2.ec2.cloud.redislabs.com:15484

# ---- Authentication ----
# IMPORTANT: Generate strong secrets for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<generate-a-64-byte-hex-secret>
REFRESH_SECRET=<generate-another-64-byte-hex-secret>

# ---- Server ----
NODE_ENV=production
PORT=3001

# ---- CORS ----
# Set to your actual frontend deployment URL
FRONTEND_URL=https://your-frontend.vercel.app

# ---- Socket.IO (Not available in Vercel serverless) ----
# SOCKET_CORS_ORIGIN=https://your-frontend.vercel.app

# ---- i18n ----
DEFAULT_LANGUAGE=en
